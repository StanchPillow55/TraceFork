{
  "$defs": {
    "AnswerCitation": {
      "description": "One source the generated answer is allowed to cite.",
      "properties": {
        "marker": {
          "title": "Marker",
          "type": "string"
        },
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "url": {
          "default": "",
          "title": "Url",
          "type": "string"
        },
        "quote": {
          "default": "",
          "title": "Quote",
          "type": "string"
        },
        "status": {
          "default": "",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "marker"
      ],
      "title": "AnswerCitation",
      "type": "object"
    },
    "AttentionComponents": {
      "description": "Passage priority for retrieval. This is not factual confidence and not a truth score.",
      "properties": {
        "R": {
          "description": "Query-token relevance in [0,1]. Not factual confidence.",
          "maximum": 1,
          "minimum": 0,
          "title": "R",
          "type": "number"
        },
        "G": {
          "description": "Overlap with unresolved gaps in [0,1]. Not factual confidence.",
          "maximum": 1,
          "minimum": 0,
          "title": "G",
          "type": "number"
        },
        "D": {
          "description": "Domain-fit or bridge-term score in [0,1]. Not factual confidence.",
          "maximum": 1,
          "minimum": 0,
          "title": "D",
          "type": "number"
        },
        "F": {
          "description": "Recency from publish_date in [0,1]. Not factual confidence.",
          "maximum": 1,
          "minimum": 0,
          "title": "F",
          "type": "number"
        },
        "score": {
          "description": "A(q,p)=0.4*R+0.3*G+0.2*D+0.1*F, clamped to [0,1]. Not factual confidence.",
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "R",
        "G",
        "D",
        "F",
        "score"
      ],
      "title": "AttentionComponents",
      "type": "object"
    },
    "Checkpoint": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "investigation_id": {
          "title": "Investigation Id",
          "type": "string"
        },
        "step": {
          "title": "Step",
          "type": "integer"
        },
        "state_json": {
          "additionalProperties": true,
          "title": "State Json",
          "type": "object"
        },
        "stop_reason": {
          "anyOf": [
            {
              "enum": [
                "evidence_sufficient",
                "low_expected_value",
                "no_useful_actions",
                "budget_exhausted",
                "unresolved_uncertainty"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop Reason"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "investigation_id",
        "step",
        "created_at"
      ],
      "title": "Checkpoint",
      "type": "object"
    },
    "Claim": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "scope": {
          "default": "",
          "title": "Scope",
          "type": "string"
        },
        "status": {
          "enum": [
            "supported",
            "contradicted",
            "insufficient",
            "hypothesis"
          ],
          "title": "Status",
          "type": "string"
        },
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "span_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Id"
        }
      },
      "required": [
        "id",
        "text",
        "status"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Contradiction": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "subject_name": {
          "title": "Subject Name",
          "type": "string"
        },
        "predicate": {
          "title": "Predicate",
          "type": "string"
        },
        "supported_object": {
          "title": "Supported Object",
          "type": "string"
        },
        "conflicting_object": {
          "title": "Conflicting Object",
          "type": "string"
        },
        "original_document_id": {
          "title": "Original Document Id",
          "type": "string"
        },
        "conflicting_document_id": {
          "title": "Conflicting Document Id",
          "type": "string"
        },
        "conflicting_relationship_id": {
          "title": "Conflicting Relationship Id",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "id",
        "subject_name",
        "predicate",
        "supported_object",
        "conflicting_object",
        "original_document_id",
        "conflicting_document_id",
        "conflicting_relationship_id",
        "detail"
      ],
      "title": "Contradiction",
      "type": "object"
    },
    "ConvergenceDecision": {
      "description": "Decision sent to and received from the convergence controller.\n\nExploration overwrites ``decision_source`` after the call. Do not treat a\nfallback rationale as a controller verdict.",
      "properties": {
        "investigation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Investigation Id"
        },
        "approved_action": {
          "anyOf": [
            {
              "$ref": "#/$defs/InvestigationAction"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "stop": {
          "default": false,
          "title": "Stop",
          "type": "boolean"
        },
        "stop_reason": {
          "anyOf": [
            {
              "enum": [
                "evidence_sufficient",
                "low_expected_value",
                "no_useful_actions",
                "budget_exhausted",
                "unresolved_uncertainty"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop Reason"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "decision_source": {
          "description": "Recorded by exploration: convergence if the endpoint was used, otherwise fallback.",
          "enum": [
            "convergence",
            "fallback"
          ],
          "title": "Decision Source",
          "type": "string"
        },
        "include_document_ids": {
          "items": {
            "type": "string"
          },
          "title": "Include Document Ids",
          "type": "array"
        },
        "archive_document_ids": {
          "items": {
            "type": "string"
          },
          "title": "Archive Document Ids",
          "type": "array"
        }
      },
      "required": [
        "rationale",
        "decision_source"
      ],
      "title": "ConvergenceDecision",
      "type": "object"
    },
    "Document": {
      "properties": {
