                "unresolved_uncertainty"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop Reason"
        },
        "decision_source": {
          "anyOf": [
            {
              "enum": [
                "convergence",
                "fallback"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Source"
        },
        "decision_rationale": {
          "default": "",
          "title": "Decision Rationale",
          "type": "string"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "usage": {
          "$ref": "#/$defs/UsageMetrics"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "live_extraction_blocked": {
          "default": false,
          "title": "Live Extraction Blocked",
          "type": "boolean"
        },
        "blocker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blocker"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "id",
        "question",
        "budget",
        "created_at",
        "updated_at"
      ],
