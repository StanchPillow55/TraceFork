        "version_id",
        "document_id",
        "text",
        "start",
        "end",
        "content_hash"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "GroundedAnswer": {
      "description": "A cited prose answer synthesized from an investigation's evidence.\n\nThe answer explains evidence the investigation already grounded. It does\nnot add facts. Every inline marker maps to one AnswerCitation. This is a\nsynthesis for the reader, not a new verification step.",
      "properties": {
        "investigation_id": {
          "title": "Investigation Id",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "markdown": {
          "title": "Markdown",
          "type": "string"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/AnswerCitation"
          },
          "title": "Citations",
          "type": "array"
        },
        "cited_markers": {
          "items": {
            "type": "string"
          },
          "title": "Cited Markers",
          "type": "array"
        },
        "model": {
          "default": "",
          "title": "Model",
          "type": "string"
        },
        "llm_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Llm Tokens"
        },
        "blocked": {
          "default": false,
          "title": "Blocked",
          "type": "boolean"
        },
        "blocker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blocker"
        }
      },
      "required": [
        "investigation_id",
        "question",
        "markdown"
      ],
      "title": "GroundedAnswer",
      "type": "object"
    },
    "Investigation": {
