        },
        "result_summary": {
          "default": "",
          "title": "Result Summary",
          "type": "string"
        }
      },
      "required": [
        "id",
        "query",
        "reason"
      ],
      "title": "InvestigationAction",
      "type": "object"
    },
    "InvestigationBudget": {
      "description": "Search budget. The exploration backend clamps enforcement to 2 searches, 5 fetched URLs, and 10 LLM calls.",
      "properties": {
        "max_searches": {
          "default": 2,
          "title": "Max Searches",
          "type": "integer"
        },
        "max_fetched_urls": {
          "default": 5,
          "title": "Max Fetched Urls",
          "type": "integer"
        },
        "max_llm_calls": {
          "default": 10,
          "title": "Max Llm Calls",
          "type": "integer"
        },
        "searches_used": {
          "default": 0,
          "title": "Searches Used",
          "type": "integer"
        },
        "urls_fetched": {
          "default": 0,
          "title": "Urls Fetched",
          "type": "integer"
        },
        "llm_calls_used": {
          "default": 0,
          "title": "Llm Calls Used",
          "type": "integer"
        },
        "min_utility": {
          "default": 0.15,
          "title": "Min Utility",
          "type": "number"
        },
        "remaining_searches": {
          "default": 2,
          "title": "Remaining Searches",
          "type": "integer"
        },
        "remaining_fetched_urls": {
          "default": 5,
          "title": "Remaining Fetched Urls",
          "type": "integer"
        },
        "remaining_llm_calls": {
          "default": 10,
          "title": "Remaining Llm Calls",
          "type": "integer"
        }
      },
      "title": "InvestigationBudget",
      "type": "object"
    },
    "KnowledgeValue": {
      "description": "Additive knowledge-value heuristic. Not query attention, not a probability, and not factual confidence.",
      "properties": {
        "R": {
          "description": "Overlap with profile interests and goals in [0,1]. Not factual confidence.",
          "maximum": 1,
          "minimum": 0,
          "title": "R",
          "type": "number"
        },
        "N": {
          "description": "Share of passage tokens absent from known claims in [0,1]. Not factual confidence.",
          "maximum": 1,
          "minimum": 0,
          "title": "N",
          "type": "number"
        },
        "B": {
          "description": "1 only when a profile interest and a DOMAIN_BRIDGES bridge term both occur and the bridge term is outside known claims; otherwise 0. Not factual confidence.",
          "maximum": 1,
          "minimum": 0,
          "title": "B",
          "type": "number"
        },
        "I": {
          "description": "Overlap with the unresolved profile interest in [0,1]. Not factual confidence.",
          "maximum": 1,
          "minimum": 0,
          "title": "I",
          "type": "number"
        },
        "C": {
          "description": "1 only when the passage contradicts a known claim with the same subject and predicate and a different object; otherwise 0. Not factual confidence.",
          "maximum": 1,
          "minimum": 0,
          "title": "C",
          "type": "number"
        },
        "score": {
          "description": "U=0.25*R+0.25*N+0.20*B+0.20*I+0.10*C, clamped to [0,1]. A heuristic, not a probability and not factual confidence.",
          "maximum": 1,
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "bridge_trigger": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bridge Trigger"
        },
        "bridge_terms": {
          "items": {
            "type": "string"
          },
          "title": "Bridge Terms",
          "type": "array"
        },
        "confirmed_known_assertion_ids": {
          "description": "User assertions (basis user_confirmation, state known) that were part of the known set when this score was recorded (1.3.0, additive). Empty for scores recorded before 1.3.0 or without confirmations.",
